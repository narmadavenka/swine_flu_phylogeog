present <- colSums(df_year[, clade_names], na.rm = TRUE) > 0
missing <- clade_names[!present]
if (length(missing) > 0) {
dummy <- df_year[1, ]
dummy[, clade_names] <- 0
dummy[, missing]     <- 1e-9
df_year <- rbind(df_year, dummy)
}
