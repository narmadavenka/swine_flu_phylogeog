states_sf <- states(cb = TRUE, resolution = "20m") %>%
filter(!NAME %in% c("Alaska", "Hawaii", "Puerto Rico")) %>%  # your states
st_transform(crs = 5070)  # Albers Equal Area - best for US maps
## get regions incorporated into states_sf
region_lookup <- tibble::tibble(
NAME = unique(states_sf$NAME),  # base R vector of US state names
region = case_when(
NAME %in% c("Connecticut","Maine","Massachusetts","New Hampshire",
"Rhode Island","Vermont","New Jersey","New York",
"Pennsylvania") ~ "Northeast",
NAME %in% c("Illinois","Indiana","Michigan","Ohio","Wisconsin",
"Iowa","Kansas","Minnesota","Missouri","Nebraska",
"North Dakota","South Dakota") ~ "Midwest",
NAME %in% c("Delaware","District of Columbia","Florida","Georgia","Maryland",
"North Carolina","South Carolina","Virginia",
"West Virginia","Alabama","Kentucky","Mississippi",
"Tennessee","Arkansas","Louisiana","Oklahoma","Texas") ~ "South",
NAME %in% c("Arizona","Colorado","Idaho","Montana","Nevada",
"New Mexico","Utah","Wyoming","Alaska","California",
"Hawaii","Oregon","Washington") ~ "West",
TRUE ~ NA_character_
)
)
states_sf <- states_sf %>%
left_join(region_lookup, by = "NAME")
# Get state centroids for pie placement
centroids <- states_sf %>%
st_centroid() %>%
mutate(
lon = st_coordinates(.)[, 1],
lat = st_coordinates(.)[, 2]
) %>%
st_drop_geometry()
## create dissolved boundaries for regions
regions_sf <- states_sf %>%
group_by(region) %>%
summarise(geometry = st_union(geometry), .groups = "drop")
#######################################
#### By year
# create summaries for each year, what proportion of clades in each state
# clade_summary <- ref %>% group_by(year, location, clade_final) %>%
#   mutate(total_clade = n()) %>% ungroup() %>%
#   group_by(year,location) %>% mutate(total_sequences = n(),
#                                      proportion_clade = total_clade/total_sequences) %>%
#   ungroup() %>% select(c(clade_final,location,year,proportion_clade)) %>% distinct()
#
# clade_summary_wide <- clade_summary %>% pivot_wider(id_cols = c(location, year),
#                                                     names_from = clade_final,
#                                                     values_from = proportion_clade) %>%
#   left_join(centroids, by = c("location" = "NAME"))
# pie_df_clean <- clade_summary_wide %>%
# Replace NA with 0
#   mutate(across(all_of(clade_names), ~ replace_na(.x, 0))) %>%
# Remove rows where all clade proportions are 0
#   rowwise() %>%
#   filter(sum(c_across(all_of(clade_names))) > 0) %>%
#   ungroup()
## by 4 year bins
# get 4 year bins
ref <- ref %>% mutate(year_bins = cut(year,
breaks = c(1998,2002,2006,2010,2014,2018,2022,2025),
labels = c("1998-2002","2003-2006",
"2007-2010","2011-2014",
"2015-2018","2019-2022",
"2023-2025"),
include.lowest = TRUE, right = TRUE))
clade_summary <- ref %>% group_by(year_bins, location, clade_final) %>%
mutate(total_clade = n()) %>% ungroup() %>%
group_by(year_bins,location) %>% mutate(total_sequences = n(),
proportion_clade = total_clade/total_sequences) %>%
ungroup() %>% select(c(clade_final,location,year_bins,proportion_clade)) %>% distinct()
clade_summary_wide <- clade_summary %>% pivot_wider(id_cols = c(location, year_bins),
names_from = clade_final,
values_from = proportion_clade) %>%
left_join(centroids, by = c("location" = "NAME"))
pie_df_clean <- clade_summary_wide %>%
# Replace NA with 0
mutate(across(all_of(clade_names), ~ replace_na(.x, 0))) %>%
# Remove rows where all clade proportions are 0
rowwise() %>%
filter(sum(c_across(all_of(clade_names))) > 0) %>%
ungroup()
#### PLOT ####
