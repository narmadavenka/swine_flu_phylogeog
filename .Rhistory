theme_void() +
theme(
legend.position   = "right",
legend.title      = element_text(face = "bold", size = 24, margin = margin(b = 15)),
legend.text       = element_text(size = 22),
legend.key.width  = unit(1.3, "cm"),
legend.key.height = unit(1.2, "cm"),
legend.spacing.y = unit(0.7, "cm")
)
gt  <- ggplotGrob(legend_source)
leg <- gt$grobs[[which(gt$layout$name == "guide-box-right")]]
panels <- wrap_plots(plot_list_nolog, ncol = 2)
panels_grob <- as_grob(panels)
final <- ggdraw() +
draw_grob(panels_grob,
x = 0, y = 0,
width = 1,
height = 1) +
draw_grob(leg,
x      = 0.50,   # start of the empty 4th column in last row
y      = 0.035,
width  = 0.45,
height = 0.22)
final
years     <- sort(unique(pie_df_clean$year_bins))
tmp_dir   <- tempdir()
img_paths <- character(length(years))
plot_list <- vector("list", length(years))
region_colours <- c(
"Northeast" = "#4F7350",  # muted green
"Midwest"   = "#A6883D",  # muted gold
"South"     = "#6E5748",  # muted brown
"West"      = "#8C4B69"   # muted dark pink
)
for (i in seq_along(years)) {
yr      <- years[i]
df_year <- pie_df_clean[pie_df_clean$year_bins == yr, ]
present <- colSums(df_year[, clade_names], na.rm = TRUE) > 0
missing <- clade_names[!present]
if (length(missing) > 0) {
dummy <- df_year[1, ]
dummy[, clade_names] <- 0
dummy[, missing]     <- 1e-9
df_year <- rbind(df_year, dummy)
}
p_yr <- ggplot() +
geom_sf(data = states_sf, aes(fill = region), color = "white", linewidth = 0.4, alpha = 0.35) +
scale_fill_manual(values = region_colours, guide = "none") +
new_scale_fill() +
geom_scatterpie(
data  = df_year,
aes(x = lon, y = lat, group = location, r = 135000),
cols  = clade_names,
color = NA,
alpha = 0.95
) +
scale_fill_manual(values = clade_colours, name = "Clade",
breaks = clade_names, drop = FALSE) +
coord_sf(crs = 5070) +
labs(title = yr) +
theme_void() +
theme(
plot.title  = element_text(face = "bold", size = 24, hjust = 0.5, margin = margin(b = -15)),
plot.margin = margin(1, 1, 1, 1)
)
plot_list[[i]] <- p_yr
img_paths[i]   <- file.path(tmp_dir, sprintf("frame_%03d.png", i))
ggsave(img_paths[i], p_yr, width = 12, height = 10, dpi = 300)
message("Saved frame ", i, " / ", length(years), " (", yr, ")")
}
